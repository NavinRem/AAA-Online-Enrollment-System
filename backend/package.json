{
  "name": "backend",
  "description": "Cloud Functions for Firebase (Enrollment)",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --import=./firebase-data --export-on-exit",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "mocha --timeout 5000 test/*.test.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:branch": "node src/scripts/seedBranch.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.3",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "supertest": "^7.2.2"
  },
  "private": true
}

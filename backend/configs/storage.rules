rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // 2. Allow public write to temp profiles (for registration)
    match /profiles/temp/{filename} {
      allow write: if true;
    }

    // 3. Allow authenticated write for everything else
    match /profiles/{uid}/{filename} {
      allow write: if request.auth != null;
    }

    // Fallback for any other path
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access to all files (useful for course images, avatars, etc.)
      allow read: if true;
      
      // Profiles/temp: Allow anyone to upload a temporary profile picture (for registration)
      match /profiles/temp/{allPaths=**} {
        allow write: if true; 
      }

      // Rest of the profiles and other paths: Only authenticated users can upload.
      match /{allPaths=**} {
        allow write: if request.auth != null;
      }
    }
  }
}

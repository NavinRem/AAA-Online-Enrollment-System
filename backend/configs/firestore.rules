rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // High-performance role check using Firebase Auth Custom Claims
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isParent() {
      return hasRole('parent');
    }

    function isOwnParent(parentId) {
      return isParent() && request.auth.uid == parentId;
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles (Parents, Teachers, Admins)
    match /parents/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin(); // Admin manages profile creation/edits via backend
    }
    match /teachers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // 2. Students: Parents manage their own kids; Staff/Admins can view
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.parentId ||
        isAdmin() || hasRole('teacher')
      );
      allow write: if isAdmin(); // Global student writes handled by backend
    }

    // 3. Programs & sessions: Publicly readable; Only Admins can modify
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Enrollments: Parents view/create/limited-update their own; Admins manage fully
    match /enrollments/{enrollId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.parentId ||
        isAdmin()
      );

      // Parent can create their OWN enrollment, but only in 'unpaid' state
      allow create: if isAdmin() ||
        (isParent() &&
         request.resource.data.parentId == request.auth.uid &&
         request.resource.data.status == 'unpaid' &&
         request.resource.data.paymentStatus == 'unpaid');

      // Parent can update ONLY payment-proof-related fields on their own enrollment,
      // and can never set paymentStatus to 'paid' themselves (admin-only)
      allow update: if isAdmin() ||
        (isParent() &&
         resource.data.parentId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['paymentProofURL', 'paymentProofSubmittedAt', 'transactionId', 'remark', 'paymentStatus']) &&
         request.resource.data.paymentStatus == 'verifying');

      allow delete: if isAdmin();
    }

    // 5. Academic Tracking (Attendance) — admin/teacher only via rules.
    // Parents access attendance ONLY through the backend API (parentController.getMyChildAttendance),
    // which filters per-student server-side. Direct client reads are blocked here because
    // a single attendance doc contains ALL students in a class — rules can't filter within it.
    match /{path=**}/attendance/{atId} {
      allow read: if isAdmin() || hasRole('teacher');
      allow write: if isAdmin() || hasRole('teacher');
    }

    // 6. Payments: Restricted financial records
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.parentId ||
        isAdmin()
      );
      allow write: if isAdmin(); // Managed by backend payment flow
    }

    // 7. Support Collections (Terms, Categories, Branches, Classes)
    match /terms/{id} { allow read: if true; allow write: if isAdmin(); }
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /branches/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /levels/{lvlId} { allow read: if true; allow write: if isAdmin(); }
    }

    // Default deny anything not explicitly matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
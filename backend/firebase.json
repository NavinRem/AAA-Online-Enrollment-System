{
  "firestore": {
    "rules": "configs/firestore.rules"
  },
  "storage": [
    {
      "target": "prod-storage",
      "bucket": "aaa-online-registration-e3833.firebasestorage.app",
      "rules": "configs/storage.rules"
    }
  ],
  "functions": {
    "source": ".",
    "ignore": [
      "firebase-debug.log",
      "firestore-debug.log",
      "ui-debug.log",
      "firebase-data/**",
      "node_modules/**"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  }
}